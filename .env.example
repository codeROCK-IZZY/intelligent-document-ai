# Copy to .env and change every CHANGE_ME value. Never commit .env.
POSTGRES_PASSWORD=CHANGE_ME_local_db_password
# python -c "import secrets; print(secrets.token_urlsafe(48))"
DOCAI_JWT_SECRET=CHANGE_ME_at_least_32_random_characters_long
DOCAI_ENV=development
DOCAI_COOKIE_SECURE=false
DOCAI_CORS_ORIGINS=["http://localhost:8080","http://localhost:5173"]
DOCAI_LOG_JSON=true
# Password for the demo users created by `python -m app.cli demo` (min 12 chars).
DOCAI_DEMO_PASSWORD=CHANGE_ME_demo_password

# --- AI provider ---
# "auto": Claude when ANTHROPIC_API_KEY is set, otherwise offline extractive mode.
DOCAI_LLM_PROVIDER=auto
# ANTHROPIC_API_KEY=sk-ant-...        # enables Claude; document passages are then sent to Anthropic
DOCAI_CLAUDE_MODEL=claude-opus-5-5
DOCAI_CLAUDE_EFFORT=medium

# Optional (AWS): store original files in S3 instead of the local volume.
# DOCAI_S3_BUCKET=
